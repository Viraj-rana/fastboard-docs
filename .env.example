# =============================================================================
# Вариант A. Локальная модель на своём GPU-сервере (Ollama, OpenAI-совместимый API)
# =============================================================================
# Эндпоинт Ollama. На сервере консультанта он проброшен SSH-туннелем
# (unit gpu-ollama-tunnel.service) с GPU-сервера на 127.0.0.1:11434.
OPENROUTER_BASE_URL=http://127.0.0.1:11434/v1
OPENROUTER_API_KEY=ollama
OPENROUTER_CHAT_MODEL=qwen3.6:27b-256k
OPENROUTER_EMBEDDING_MODEL=bge-m3
OPENROUTER_TIMEOUT=600
OPENROUTER_MAX_RETRIES=3

# qwen3.6 — рассуждающая модель: без отключения «мыслей» ответ уходит в reasoning,
# а content приходит пустым.
CHAT_EXTRA_BODY={"reasoning_effort": "none"}

# =============================================================================
# Вариант B. Облако через OpenRouter (https://openrouter.ai/keys)
# =============================================================================
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_CHAT_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# CHAT_EXTRA_BODY={}

# Атрибуция для рейтингов OpenRouter (необязательно)
OPENROUTER_HTTP_REFERER=https://github.com/RachoYA/fastboard-docs
OPENROUTER_X_TITLE=Fastboard Docs Consultant

# =============================================================================
# Telegram-бот (scripts/telegram_bot.py)
# =============================================================================
TELEGRAM_BOT_TOKEN=123456:AA...

# Кто может пользоваться ботом: список chat_id через запятую. Пусто = все.
# У модели один слот на GPU и один рабочий поток, поэтому публичная ссылка
# без ограничений выстроит очередь из посторонних.
ALLOWED_CHATS=
# Не больше стольких вопросов на чат в час (0 — без ограничения)
RATE_LIMIT_PER_HOUR=60
# Рабочих потоков бота и размер очереди. Генерацию GPU всё равно сериализует,
# но поиск, скачивание файлов и отправку в Telegram потоки делают параллельно.
WORKERS=2
QUEUE_SIZE=25
# Кэш ответов на повторяющиеся вопросы (сбрасывается при обновлении базы)
ANSWER_CACHE_TTL=86400
ANSWER_CACHE_SIZE=500
# Куда отправлять человека по команде /human
SUPPORT_CONTACT=
# Кому слать сообщения о сбоях (сторож scripts/watchdog.sh). Пусто = только в журнал.
ADMIN_CHAT_ID=

# Ollama для распознавания изображений (нативный API — поддерживает картинки
# и отключение режима рассуждений).
OLLAMA_URL=http://127.0.0.1:11434
VISION_MODEL=qwen3.6:27b-256k

# Text chat only. Leave ollama until vLLM on :8000 is checked. Images stay on Ollama.
LLM_BACKEND=ollama
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=

# Размер контекста. Пусто = не переопределять: модель на GPU уже загружена
# с контекстом 256k и делится с другими сервисами; переопределение вызвало бы
# перезагрузку модели.
NUM_CTX=
NUM_PREDICT=1400
TEMPERATURE=0.2
RAG_TOP_K=10
SETTINGS_TOP_K=4
SETTINGS_MAX_DISTANCE=0.95

# Разбиение вопроса на несколько поисковых запросов перед поиском по базе.
# Нужно для вопросов сразу о нескольких вещах («кому какие отчёты видно» +
# «фильтр по региону»): один общий вектор находил только одну из тем.
QUERY_SPLIT=1
MAX_QUERIES=3
INDEX_IN_CONTEXT=1
MAX_SOURCES=3
LLM_TIMEOUT=240
LLM_RETRIES=1
HISTORY_TURNS=6

# Веб-API виджета Фиби (scripts/web_api.py). Сайты, которым браузер разрешит
# обращаться к API; лимиты — на один адрес клиента в час. SPEND_LIMIT_ALERT —
# после стольких вопросов за сутки прислать предупреждение в ADMIN_CHAT_ID (0 — выкл.).
CORS_ORIGINS=https://help.fastboard.online,http://localhost:3000,https://users-docs-dev.fb-dev.winsolutions.ru
WEB_RATE_LIMIT_PER_HOUR=60
WEB_HANDOFF_LIMIT_PER_HOUR=5
WEB_HISTORY_TURNS=6
SPEND_LIMIT_ALERT=0
# Адрес и порт — только для ручного запуска `python scripts/web_api.py`;
# служба fastboard-web.service слушает 127.0.0.1:8080 (так задано в юните).
WEB_API_HOST=127.0.0.1
WEB_API_PORT=8080

# Пауза в секундах, после которой сообщения считаются законченной мыслью.
# Всё, что пришло подряд с меньшим интервалом (текст + скриншот, несколько
# картинок), склеивается в один вопрос и получает один ответ.
AGGREGATE_WINDOW=2.5

# Стриминг ответа: текст проявляется в чате по мере генерации через черновики
# Telegram (sendMessageDraft, Bot API 10.0). DRAFT_INTERVAL — как часто обновлять
# черновик (не чаще ~80 мс, иначе рейт-лимит).
DRAFT_STREAMING=1
DRAFT_INTERVAL=0.4
MAX_PDF_PAGES=3
